# Database Connection
# Untuk Supabase/PostgreSQL di cloud:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Untuk local testing (default otomatis fallback ke SQLite jika dikosongkan):
DATABASE_URL=sqlite:///./ai_learning.db

# JWT Secret
JWT_SECRET=super-secret-jwt-key-for-ai-learning-insight-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Insight via Google Gemini (Opsional)
GOOGLE_API_KEY=

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=*
